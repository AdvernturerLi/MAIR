# 密钥（含 API key，勿提交）
config.yml

# 工具代码（软链接到 AgenticIR 的 13G 工具 repo，另行部署）
executor/*/tools/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# 输出与日志
output/
*.log

# 数据集
dataset/

# 实验数据（图像等大文件不入库；脚本/manifest/文档入库）
experiments/datasets/*/validation/
experiments/datasets/*/test/
experiments/functional_verification/lq/
experiments/functional_verification/runs/
experiments/baselines/*/runs/
experiments/baselines/*/preflight/
*.tar.gz
